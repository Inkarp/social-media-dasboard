# Copy to .env.local and fill in. See .env.local for the full setup walkthrough.
# All three come from: Supabase dashboard -> Project Settings -> API (or API Keys)

# e.g. https://abcdefghijklm.supabase.co  (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon / public / publishable key. Safe to expose — row-level security is the
# access control, so this key physically cannot write to any table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role / secret key. NEVER prefix with NEXT_PUBLIC_. Read only by
# scripts/seed.ts, which runs on your machine and must bypass row-level security
# to upsert principals and product managers. Not needed to run the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
